enum Status {
  active
  inactive
  suspended
  deleted
}

model User {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  studentNumber  String
  email          String   @unique
  userName       String
  firstName      String
  lastName       String
  middleName     String?
  status         Status
  profilePicture String
  password       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
